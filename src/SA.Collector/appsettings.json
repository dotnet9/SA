{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Sa": {
    "DataDirectory": "data",
    "Collector": {
      "Enabled": true,
      "QuoteIntervalSeconds": 3,
      "FullScanIntervalSeconds": 60,
      "DailyRefreshTime": "15:40",
      "MaxRetry": 3,
      "BackoffBaseMs": 1000,
      "MaxConcurrency": 4,
      "PerHostMinIntervalMs": 700,
      "TimeoutSeconds": 20,
      "DegradeAfterFailures": 3,
      "CooldownMinutes": 5,
      "BreakerThreshold": 3,
      "BreakerCooldownSeconds": 60,
      "EnableTencentFallback": true,
      "CollectOnNonTradingDay": true,
      "OverviewCacheSeconds": 60
    }
  }
}
